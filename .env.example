# ==============================================================================
# F-Alumni Web Administration Portal - Environment Variables Template
# ==============================================================================

# Central API Gateway (Port 5000)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Deployed Microservices on Render (Direct Cloud access fallback)
VITE_ADMIN_SERVICE_URL=https://f-alumni-admin-service.onrender.com/api/v1
VITE_USER_SERVICE_URL=https://f-alumni-user-service.onrender.com/api/v1
VITE_FORUM_SERVICE_URL=https://f-alumni-forum-service.onrender.com/api/v1
VITE_CHAT_SERVICE_URL=https://f-alumni-chat-service.onrender.com/api/v1
VITE_AI_SERVICE_URL=https://f-alumni-ai-service.onrender.com/api/v1

# SignalR WebSocket Hubs
VITE_CHAT_HUB_URL=http://localhost:5000/hubs/chat
VITE_FORUM_HUB_URL=http://localhost:5000/hubs/forum
